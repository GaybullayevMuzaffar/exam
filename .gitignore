# Зависимости (не добавляются в репозиторий, так как устанавливаются через npm/yarn)
node_modules/
jspm_packages/
bower_components/

# Логи
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Секретные файлы и переменные окружения (ОБЯЗАТЕЛЬНО К ИГНОРИРОВАНИЮ)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Директории сборки и компиляции (если используется TypeScript / Babel / Webpack)
dist/
build/
lib-cov
coverage
.nyc_output
.tsbuildinfo

# Данные рантайма (PID-файлы, сессии)
pids
*.pid
*.seed
*.pid.lock

# Кэш инструментов и IDE
.npm
.eslintcache
.stylelintcache
.node_repl_history
.cache/
.parcel-cache
.turbo/

# Конфигурации редакторов кода и операционных систем
.vscode/
.idea/
.DS_Store
Thumbs.db
